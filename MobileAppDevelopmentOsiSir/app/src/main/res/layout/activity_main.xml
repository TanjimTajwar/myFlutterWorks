<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/screen_gradient_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Java Multi Tool App"
            android:textColor="@color/title_text"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Choose one feature"
            android:textColor="@color/subtitle_text" />

        <Button
            android:id="@+id/btnFeature1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/button_gradient_bg"
            android:text="1) Temperature Converter"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/btnFeature2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/button_gradient_bg"
            android:text="2) BMI Calculator"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/btnFeature3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/button_gradient_bg"
            android:text="3) General Calculator"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/btnFeature4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/button_gradient_bg"
            android:text="4) Islamic Inheritance"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/btnFeature5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/button_gradient_bg"
            android:text="5) Reverse String Tool"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/btnFeature6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/button_gradient_bg"
            android:text="6) To-Do List Manager"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/btnFeature7"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/button_gradient_bg"
            android:text="7) Phone Call Simulator"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/btnFeature8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/button_gradient_bg"
            android:text="8) Zakah Calculator"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/btnFeature9"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/button_gradient_bg"
            android:text="9) Email Sender Simulator"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/btnFeature10"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/button_gradient_bg"
            android:text="10) Children Math Quiz"
            android:textColor="@color/white" />

    </LinearLayout>
</ScrollView>
